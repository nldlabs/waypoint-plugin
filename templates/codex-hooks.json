{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --harness codex --event sessionstart",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__waypoint__waypoint_(start_run|checkpoint_run|complete_run)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --harness codex --event pretooluse",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__waypoint__waypoint_await_decision",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --harness codex --event pretooluse",
            "timeout": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__waypoint__waypoint_(raise_decision|propose_plan)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --harness codex --event posttooluse",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
