{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event sessionstart",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_waypoint_)?waypoint__waypoint_(start_run|checkpoint_run|complete_run)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event pretooluse",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_waypoint_)?waypoint__waypoint_(await_decision|await_work)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event pretooluse",
            "timeout": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_waypoint_)?waypoint__waypoint_(raise_decision|propose_plan|await_work)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event posttooluse",
            "timeout": 1800
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event posttooluse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__WAYPOINT_HOOK__\" --event posttoolusefailure",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
